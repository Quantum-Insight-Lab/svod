# Скопируй в .env и заполни значения:
#   copy .env.example .env

# Claude / Anthropic API (достаточно одного ключа)
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=

# news_extract.py — заголовки (Haiku, дёшево)
CLAUDE_MODEL=claude-haiku-4-5-20251001
EXTRACT_LIMIT=0

# article_extract.py — тело статей (Sonnet)
ARTICLE_MODEL=claude-sonnet-4-6
ARTICLE_LIMIT=0

# ratchet.py — тайм-аут checks/apply, секунды
RATCHET_TIMEOUT=120

# каталог данных (по умолчанию <корень>/data)
SVOD_DATA=
